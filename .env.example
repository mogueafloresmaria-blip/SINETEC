# ===================================================================
# Plantilla de Variables de Entorno - EduNova (SINETEC) Producción
# ===================================================================

# Clave secreta criptográfica (generar una única de 50+ caracteres para producción)
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-produccion-cambiar-por-cadena-aleatoria-de-50-caracteres

# Modo depuración (Debe ser False en producción)
DEBUG=False

# Dominios y direcciones IP autorizadas (separados por coma)
ALLOWED_HOSTS=midominio.com,www.midominio.com,127.0.0.1,localhost

# Orígenes confiables para protección CSRF (separados por coma)
CSRF_TRUSTED_ORIGINS=https://midominio.com,https://www.midominio.com

# -------------------------------------------------------------------
# Configuración de Base de Datos MySQL
# -------------------------------------------------------------------
DB_NAME=sinetec
DB_USER=edunova_user
DB_PASSWORD=ContraseñaSuperSegura_2026*
DB_HOST=127.0.0.1
DB_PORT=3306

# Alternativa: Para usar SQLite en entornos de pruebas, descomentar:
# USE_SQLITE=False

# -------------------------------------------------------------------
# Parámetros de Seguridad SSL/HTTPS (Activar con SSL instalado)
# -------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# -------------------------------------------------------------------
# Configuración del Servicio de Correo Saliente (SMTP / Notificaciones)
# -------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notificaciones.edunova@gmail.com
EMAIL_HOST_PASSWORD=token_de_aplicacion_gmail
DEFAULT_FROM_EMAIL=EduNova Notificaciones <notificaciones.edunova@gmail.com>
